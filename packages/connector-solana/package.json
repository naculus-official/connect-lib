{
  "name": "@naculus/connector-solana",
  "version": "0.2.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "sideEffects": false,
  "dependencies": {
    "@naculus/connect-core": "workspace:*",
    "@naculus/siwx": "workspace:*",
    "@solana/web3.js": "^2.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@noble/curves": "^1.9.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naculus-official/connect-lib.git"
  },
  "license": "MIT",
  "keywords": [
    "web3",
    "solana",
    "wallet"
  ],
  "description": "Solana wallet connector (Wallet Standard)",
  "homepage": "https://github.com/naculus-official/connect-lib#readme",
  "bugs": "https://github.com/naculus-official/connect-lib/issues"
}
