{
  "name": "@naculus/wallet-engine",
  "version": "0.2.1",
  "type": "module",
  "description": "Embedded wallet engine (BIP39, HD keys, signing)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.worker.config.ts",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@naculus/connect-core": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0"
  },
  "devDependencies": {
    "@naculus/connect-core": "workspace:*",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/naculus-official/connect-lib.git"
  },
  "license": "MIT",
  "keywords": [
    "web3",
    "wallet",
    "hd-wallet",
    "bip39",
    "bip32",
    "embedded"
  ],
  "homepage": "https://github.com/naculus-official/connect-lib#readme",
  "bugs": "https://github.com/naculus-official/connect-lib/issues"
}
